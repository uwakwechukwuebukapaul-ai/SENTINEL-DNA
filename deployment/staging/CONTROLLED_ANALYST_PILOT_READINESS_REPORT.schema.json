{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-dna.example/schemas/controlled-analyst-pilot-readiness-report-1.0.json",
  "title": "Sentinel DNA Controlled Analyst Pilot Readiness Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "status",
    "manifest_status",
    "provider_status",
    "image_digest_status",
    "origin_status",
    "tenant_isolation_status",
    "audit_status",
    "final_readiness_decision",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "status": {
      "enum": ["READY_FOR_ANALYST_PILOT", "BLOCKED_WITH_REASON"]
    },
    "manifest_status": { "enum": ["PASS", "BLOCKED"] },
    "provider_status": { "enum": ["PASS", "BLOCKED"] },
    "image_digest_status": { "enum": ["PASS", "BLOCKED"] },
    "origin_status": { "enum": ["PASS", "BLOCKED"] },
    "tenant_isolation_status": { "enum": ["PASS", "BLOCKED"] },
    "audit_status": { "enum": ["PASS", "BLOCKED"] },
    "final_readiness_decision": {
      "enum": ["READY_FOR_ANALYST_PILOT", "BLOCKED_WITH_REASON"]
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "reason"],
        "properties": {
          "name": {
            "enum": [
              "provider_configured",
              "runtime_reachable",
              "browser_contract_valid",
              "origin_reachable",
              "browser_auth_available",
              "evidence_directory_writable",
              "audit_prerequisites_available",
              "activation_manifest_valid"
            ]
          },
          "status": { "enum": ["PASS", "BLOCKED"] },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_.: -]+$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "READY_FOR_ANALYST_PILOT" } }
      },
      "then": {
        "properties": {
          "final_readiness_decision": { "const": "READY_FOR_ANALYST_PILOT" },
          "checks": {
            "items": { "properties": { "status": { "const": "PASS" } } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "BLOCKED_WITH_REASON" } }
      },
      "then": {
        "properties": {
          "final_readiness_decision": { "const": "BLOCKED_WITH_REASON" }
        }
      }
    }
  ]
}
