# Sentinel DNA non-production staging template.
# This file contains non-secret configuration defaults only. Do not put real
# secrets here or commit a populated copy. Inject non-production values through
# the approved secret and configuration store on the staging host.

SENTINEL_DNA_ENV=staging
SENTINEL_DNA_PILOT_ACCESS_REQUIRED=1
SENTINEL_DNA_SECURE_COOKIES=1
FLASK_DEBUG=0
SENTINEL_DNA_TENANT_ISOLATION_ENABLED=1
SENTINEL_DNA_AUDIT_LOGGING_ENABLED=1
# FAVP execution is disabled unless an operator explicitly enables it in a
# non-production environment. Never set this in a production environment.
SENTINEL_DNA_FAVP_OPERATIONS_ENABLED=0
SENTINEL_DNA_FAVP_SYNTHETIC_ONLY=1
SENTINEL_DNA_FAVP_PRODUCTION_ACCESS=0
SENTINEL_DNA_FAVP_EVIDENCE_DIR=/var/lib/sentinel/favp-evidence
SENTINEL_DNA_TRUSTED_BROWSER_CLIENT=deployment/staging/scripts/trusted_browser_service/browser-client.mjs
SENTINEL_DNA_TRUSTED_BROWSER_UPSTREAM_CLIENT=deployment/staging/scripts/trusted_browser_service/providers/playwright-runtime-provider.mjs
# The runtime and manifest must exist in the approved operator environment;
# these conventional paths are intentionally not created by this repository.
SENTINEL_DNA_APPROVED_PLAYWRIGHT_RUNTIME=C:\approved\browser\playwright-runtime.mjs
# SHA-256 of the exact external runtime module above; reconcile it through
# the operator activation helper and the external custody manifest.
SENTINEL_DNA_APPROVED_RUNTIME_DIGEST=sha256:<64-hex-runtime-digest>
SENTINEL_DNA_BROWSER_AUTH_BRIDGE=C:\approved\browser\browser-auth-bridge.mjs
SENTINEL_DNA_TRUSTED_BROWSER_ACTIVATION_MANIFEST=C:\approved\browser\trusted-browser-activation-manifest.json
SENTINEL_DNA_CONFIG_SOURCE_CLASSIFICATION=external_non_production
SENTINEL_DNA_DATABASE_TARGET_CLASSIFICATION=disposable_staging

# Required non-production application secret; never reuse production material.
SENTINEL_DNA_SECRET_KEY=__INJECT_NON_PRODUCTION_SECRET__

# The staging Compose contract uses private disposable PostgreSQL. The
# password is injected from an external Docker-secret file and the URL is
# assembled inside Compose; never point it at production. These are host file
# paths, not password values, and both files must remain outside the repository.
# The SQLite compatibility path is rooted at the staging app volume mount;
# DATABASE_URL remains authoritative.
SENTINEL_DNA_DB_PATH=/var/lib/sentinel/soc.db
SENTINEL_DNA_POSTGRES_PASSWORD=__INJECT_DISPOSABLE_STAGING_PASSWORD__
SENTINEL_DNA_STAGING_APP_SECRET_FILE=C:\approved\sentinel-dna-secrets\app\secret_key.txt
SENTINEL_DNA_STAGING_POSTGRES_PASSWORD_FILE=C:\approved\sentinel-dna-secrets\postgres\password.txt

# The staging Compose contract provides private Redis.

# The endpoint is supplied only after private infrastructure validation.
REMOTE_ANALYST_ENDPOINT=NOT_PROVIDED
SENTINEL_DNA_BASE_URL=https://sentinel-dna-staging:18443
SENTINEL_DNA_STAGING_EDGE_CONFIG_FILE=__EXTERNAL_EDGE_CONFIG_FILE__
SENTINEL_DNA_STAGING_TLS_DIR=__EXTERNAL_TLS_DIRECTORY__
# Optional override for an approved external CA; otherwise deploy.sh uses
# $SENTINEL_DNA_STAGING_TLS_DIR/staging-ca.crt as the explicit trust anchor.
# SENTINEL_DNA_STAGING_TLS_CA_FILE=__EXTERNAL_TRUSTED_CA_FILE__
SENTINEL_DNA_STAGING_EDGE_IMAGE=nginx:1.27-alpine

# The certificate generator always includes the stable staging hostname and
# 127.0.0.1. Set this to the staging VM's current LAN address; it is not an
# application bind address and must not be hard-coded in application code.
SENTINEL_DNA_STAGING_TLS_IP=192.168.1.115

# Optional non-secret custody metadata. Populate outside this template for a
# reviewed staging run; do not claim a release or analyst execution here.
# SENTINEL_DNA_IMAGE_REVISION_FULL=__REVIEWED_COMMIT_FULL_SHA__
# SENTINEL_DNA_IMAGE_TAG=__NON_PRODUCTION_IMAGE_TAG__
# SENTINEL_DNA_IMAGE_CREATED=__UTC_BUILD_TIMESTAMP__
